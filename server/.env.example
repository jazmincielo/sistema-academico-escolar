# ===== Servidor =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== MongoDB (Atlas o local) =====
# Local:  mongodb://127.0.0.1:27017/sistema_academico
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sistema_academico
MONGODB_URI=mongodb://127.0.0.1:27017/sistema_academico

# ===== Seguridad =====
# Genere una clave larga: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esta_clave_por_una_aleatoria_de_64_caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# ===== OTP (autenticación por correo) =====
OTP_TTL_MINUTES=3
# Solo desarrollo: devuelve el código OTP en la respuesta de la API (NUNCA en producción)
EXPOSE_DEV_OTP=true

# ===== SMTP (opcional; si está vacío los correos se imprimen en consola) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sistema Académico Escolar <no-reply@colegio.edu>"
